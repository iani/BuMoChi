{
  "name": "deck",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Browser-native slide deck for the AI & Music 2026 hackathon, with reliable HTML -> PDF export.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "deck": "node src/export-pdf.mjs src/deck.html out/deck.pdf",
    "deck:dark": "node src/export-pdf.mjs src/deck.html out/deck-dark.pdf --theme dark",
    "deck:open": "xdg-open src/deck.html 2>/dev/null || open src/deck.html"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "puppeteer": "25.10.0"
  }
}
